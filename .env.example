APP_PORT=8080
API_PORT=8000
AI_PORT=8001
MYSQL_PORT=3306
MYSQL_DATABASE=flts
MYSQL_USER=flts
MYSQL_PASSWORD=flts_secret
MYSQL_ROOT_PASSWORD=root_secret
# Laravel's authoritative file validation limit; keep it aligned with backend/Dockerfile and nginx.conf.
DOCUMENT_MAX_KB=10240
MAILPIT_PORT=8025

# Mail configuration (Default: local Mailpit; for Gmail SMTP, see instructions in README)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@flts.test
MAIL_FROM_NAME=FLTS
